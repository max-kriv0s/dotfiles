# [term]
term = xterm-256color

# [font]
font-family = "JetBrainsMono Nerd Font"
#font-family = "Hack Nerd Font"
font-size = 17
font-thicken = true

# [theme]
# Catppuccin Mocha
#theme = Catppuccin Mocha

# Kanagawa Dragon
theme = Kanagawa Dragon

# [window]
window-width = 110
window-height = 32
window-padding-x = 12
window-padding-y = 12

# Скрывать шапку окна
window-decoration = true

# [visual effects]
background-opacity = 0.92
background-blur-radius = 15

# [cursor]
cursor-style = block
cursor-style-blink = false
shell-integration-features = no-cursor
cursor-opacity = 0.9

# [behavior]
macos-option-as-alt = true

# [keybind]
keybind = shift+enter=text:\x1b[13;2u

# Дубли основных сочетаний через физические коды клавиш (W3C UI Events).
# Обычные keybind = super+c=... матчатся по символу, который зависит от
# раскладки (на RU-раскладке super+c это по факту super+с). Физические коды
# (KeyC и т.п.) матчат физическую клавишу независимо от раскладки и имеют
# приоритет над буквенными триггерами — можно смело добавлять поверх дефолтов.
keybind = super+KeyC=copy_to_clipboard:mixed
keybind = super+KeyV=paste_from_clipboard
keybind = super+KeyT=new_tab
keybind = super+KeyN=new_window
keybind = super+KeyW=close_surface
keybind = super+KeyD=new_split:right
keybind = super+shift+KeyD=new_split:down
keybind = super+KeyA=select_all
keybind = super+KeyK=clear_screen
keybind = super+KeyF=start_search
keybind = super+KeyE=search_selection
keybind = super+shift+KeyF=end_search
keybind = super+KeyZ=undo
keybind = super+shift+KeyZ=redo
keybind = super+KeyQ=quit
keybind = super+Comma=open_config
keybind = super+shift+Comma=reload_config
keybind = super+BracketLeft=goto_split:previous
keybind = super+BracketRight=goto_split:next
keybind = super+shift+BracketLeft=previous_tab
keybind = super+shift+BracketRight=next_tab

# Ctrl+буква — раскладко-независимые управляющие коды для шелла.
# По умолчанию Ghostty считает control-байт из символа ТЕКУЩЕЙ раскладки:
# на русской раскладке физическая клавиша C даёт кириллическую «с», для
# которой корректного control-байта не существует — Ctrl+C/Ctrl+D и т.п.
# просто не отправляют в шелл ничего. Бинды ниже — по физической клавише,
# всегда шлют классический control-байт независимо от раскладки.
# начало строки (readline) + префикс tmux
keybind = ctrl+KeyA=text:\x01
# SIGINT — прервать процесс
keybind = ctrl+KeyC=text:\x03
# EOF / выйти из шелла
keybind = ctrl+KeyD=text:\x04
# конец строки (readline)
keybind = ctrl+KeyE=text:\x05
# очистить экран
keybind = ctrl+KeyL=text:\x0c
# обратный поиск по истории
keybind = ctrl+KeyR=text:\x12
# отправить процесс в фон (suspend)
keybind = ctrl+KeyZ=text:\x1a
# на символ назад / вперёд (readline)
keybind = ctrl+KeyB=text:\x02
keybind = ctrl+KeyF=text:\x06
# отмена текущего действия (readline abort, выход из fzf)
keybind = ctrl+KeyG=text:\x07
# удалить до конца строки
keybind = ctrl+KeyK=text:\x0b
# удалить всю строку до курсора
keybind = ctrl+KeyU=text:\x15
# удалить слово перед курсором
keybind = ctrl+KeyW=text:\x17
# вставить удалённое (yank)
keybind = ctrl+KeyY=text:\x19
# поменять символы местами (transpose)
keybind = ctrl+KeyT=text:\x14
# предыдущая / следующая команда в истории
keybind = ctrl+KeyP=text:\x10
keybind = ctrl+KeyN=text:\x0e

# Alt+буква — та же проблема, но для word-motion в readline.
# macos-option-as-alt = true шлёт ESC + символ текущей раскладки, поэтому на
# RU получается ESC + кириллица. Физические коды шлют ESC + латинскую букву.
# на слово назад / вперёд
keybind = alt+KeyB=text:\x1bb
keybind = alt+KeyF=text:\x1bf
# удалить слово после курсора
keybind = alt+KeyD=text:\x1bd
