# ╔══════════════════════════════════════════════════════════════════════════╗
# ║                        BREWFILE.DEV                                     ║
# ║  Набор для dev-машины / тестового стенда — без личных приложений        ║
# ║  Установка:  brew bundle --file=packages/macos/Brewfile.dev             ║
# ║  Проверка:   brew bundle check --file=packages/macos/Brewfile.dev       ║
# ╚══════════════════════════════════════════════════════════════════════════╝

# ── Терминалы ───────────────────────────────────────────────────────────────
cask "ghostty"               # основной терминал (нативный, Metal)
cask "alacritty"             # запасной терминал

# ── Шрифты ──────────────────────────────────────────────────────────────────
cask "font-jetbrains-mono-nerd-font"  # основной шрифт с иконками

# ── Shell ────────────────────────────────────────────────────────────────────
brew "stow"                  # управление симлинками dotfiles
brew "tmux"                  # терминальный мультиплексор

# ── Редакторы ────────────────────────────────────────────────────────────────
cask "visual-studio-code"    # основной редактор
cask "zed"                   # быстрый редактор
brew "neovim"                # терминальный редактор

# ── Git ──────────────────────────────────────────────────────────────────────
brew "git"                   # актуальная версия (не системный macOS git)
brew "git-delta"             # pager для git — прописан в .gitconfig
brew "gh"                    # GitHub CLI

# ── Современные замены unix утилит ──────────────────────────────────────────
brew "eza"                   # замена ls
brew "bat"                   # замена cat
brew "fd"                    # замена find
brew "ripgrep"               # замена grep
brew "fzf"                   # fuzzy finder — инициализируется в .zshrc
brew "zoxide"                # замена cd — инициализируется в .zshrc
brew "tldr"                  # короткие примеры вместо man
brew "tree"                  # вывод структуры папок

# ── Файловый менеджер ────────────────────────────────────────────────────────
brew "yazi"                  # TUI файловый менеджер

# ── Dev: языки и версионирование ─────────────────────────────────────────────
brew "fnm"                   # Node Version Manager
brew "uv"                    # Python менеджер
brew "go"                    # Golang
brew "lua"                   # Lua

# ── Dev: утилиты ─────────────────────────────────────────────────────────────
brew "go-task"               # таск-раннер (Taskfile.yml), замена Makefile
cask "docker-desktop"        # Docker
brew "lazydocker"            # TUI для управления Docker контейнерами
brew "lazygit"               # TUI клиент для git
cask "bruno"                 # HTTP-клиент, коллекции хранятся в git
cask "tableplus"             # GUI для баз данных

# ── Браузеры ─────────────────────────────────────────────────────────────────
cask "brave-browser"         # основной браузер

# ── Система ──────────────────────────────────────────────────────────────────
cask "linearmouse"           # настройка скролла для внешних мышей
cask "betterdisplay"         # HiDPI и настройка внешних мониторов
cask "appcleaner"            # полное удаление приложений с файлами
cask "utm"                   # виртуальные машины (замена VirtualBox для M1+)
