# Dotfiles
alias dotfiles="cd $DOTFILES"

# Editors
alias nv="nvim"

# Theme
alias theme="$DOTFILES/scripts/theme/change-theme"

# Замены стандартных утилит
alias ls="eza --tree --level=1 --icons=always --time-style='+%d %b %H:%M'"

# Git
alias g="git"
alias gs="git status"
alias gp="git push"
alias gl="git pull"
alias glog="git log"

# Tmux
alias tsk="tmux kill-session -t"
